{
  "uid": "platformcare",
  "title": "PlatformCare - customer health and support",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "title": "Usage analytics - customer impact",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Consumer:** Daily usage dashboard \u00b7 **Owner:** demo-data-team \u00b7 **Workload:** synthetic\n\n**Freshness objective:** output age \u2264 300 seconds. Check whether a successful output exists before interpreting data age. A failed job can affect data readiness while the API remains available.\n\n**Next step:** inspect the failed run logs and matching runbook in PlatformCare or use `/platform-help` in Slack."
      }
    },
    {
      "id": 1,
      "title": "Data age / 300s objective",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "platform_freshness_seconds",
          "refId": "A",
          "legendFormat": "Data age / 300s objective"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "Successful output exists",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
