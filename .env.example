# No hosted LLM calls in offline mode. Copy to .env, never commit credentials.
MODEL_MODE=offline
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=
MODEL_API_KEY=
PLATFORM_DB=data/platform.db
PLATFORM_API=http://127.0.0.1:8000
PROMETHEUS_URL=http://127.0.0.1:9090
# Generate your own token before allowing access beyond your laptop.
PLATFORM_TOKEN=local-demo-change-me
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALERT_CHANNEL=

# Optional external service smoke checks. Never needed by the core app.
TRINO_URL=
FLINK_URL=
DRUID_URL=
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
PAGERDUTY_ROUTING_KEY=
